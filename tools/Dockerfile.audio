# 配樂轉檔：`.MDS` → MIDI → OGG Vorbis。
#
# `.MDS` 是原版自己的樂曲格式（`docs/internals/17`），先用
# `tools/scripts/mds_export.py` 轉成標準 MIDI，再在這裡合成成音訊。
#
# ⚠ **這個 image 不含任何原版素材**，只有合成器與編碼器。曲子要玩家
# 自備原版之後自己轉，產物落在 gitignore 的目錄（AGENTS.md 的硬規則：
# 原始遊戲檔不進版控，公開發行包不含原版素材；私有保存版依 assets/original/ 契約處理）。
#
# 音色庫用 Debian 的 `fluid-soundfont-gm`（FluidR3_GM，可自由散布的授權），
# 所以不必玩家再去找一份；要換成自己的就用 `-sf`。
#
# ⚠ **這是 General MIDI 的音色，不是原版的 FM 音源。** `_M` 那一組
# （MPU-401／GM）用它合出來接近當年在 MIDI 音源上聽到的；`_F` 那一組
# 是寫給 OPL 的，用 GM 音色只是「同一首曲子」而不是「同一個聲音」。
# FM 走另一條路：dosgolem 錄 OPL 暫存器寫入成 VGM，AdPlug 2.3.3
# 的 factory 直接合成（docs/re/275、359），不經 DRO 或毫秒捨入。
# `opl2wav` 自己編：Debian 有 `libadplug-dev`，但**沒有 `adplay`**
# （`adplug-utils` 只裝 `adplugdb`），也沒有任何 VGM 播放器。
FROM debian:bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
      g++ pkg-config libadplug-dev cmake curl ca-certificates libglib2.0-dev \
 && rm -rf /var/lib/apt/lists/*
COPY opl2wav.cpp /tmp/opl2wav.cpp
RUN g++ -O2 -o /usr/local/bin/opl2wav /tmp/opl2wav.cpp $(pkg-config --cflags --libs adplug)
RUN apt-get update && apt-get install -y --no-install-recommends make \
 && rm -rf /var/lib/apt/lists/*

# Munt 2.8.2，固定官方來源；ROM由使用者唯讀提供，不放進image。
RUN curl -fL --retry 3 https://codeload.github.com/munt/munt/tar.gz/3b05ec276f9e605af86b0eaef7f5eda43477a31f -o /tmp/munt.tar.gz \
 && echo '209e1042a3e4392f0c807467e9afcc56cc5b14fd3bbb49655a4689e8febf51ec  /tmp/munt.tar.gz' | sha256sum -c - \
 && mkdir /tmp/munt \
 && tar -xzf /tmp/munt.tar.gz -C /tmp/munt --strip-components=1 \
 && cmake -S /tmp/munt -B /tmp/munt-build -DCMAKE_BUILD_TYPE=Release \
      -Dmunt_WITH_MT32EMU_QT=OFF -Dlibmt32emu_BUILD_TESTING=OFF -DBUILD_SHARED_LIBS=OFF \
 && cmake --build /tmp/munt-build --parallel 2 \
 && cmake --install /tmp/munt-build

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      fluidsynth fluid-soundfont-gm ffmpeg libadplug-2.3.3-0 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/local/bin/opl2wav /usr/local/bin/opl2wav
COPY --from=build /usr/local/bin/mt32emu-smf2wav /usr/local/bin/mt32emu-smf2wav
COPY --from=build /usr/local/share/doc/munt /usr/local/share/doc/munt
RUN apt-get update && apt-get install -y --no-install-recommends python3 \
 && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /usr/local/share/logh3-audio \
 && dpkg-query -W > /usr/local/share/logh3-audio/dpkg-versions.tsv

ENV HOME=/tmp
