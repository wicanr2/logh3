# #69 Windows 音樂來源建置環境；入口 tools/music_cross.sh。
# 沿用已核對的 fd2 MinGW image，只補它缺少的來源建置工具。
# 父 image 身份由包裝器核對；不修改其他專案 image 或原始碼。
FROM fd2-build-mingw:latest@sha256:4ed8c0dc9513b4cf2127ae988aee7a9e238d41ec5ef4f5e0a5c6cb146b09d356
RUN apt-get update && apt-get install -y --no-install-recommends \
    autoconf=2.71-3 automake=1:1.16.5-1.3 \
    libtool=2.4.7-7~deb12u1 libtool-bin=2.4.7-7~deb12u1 \
    patch=2.7.6-7 dpkg-dev=1.21.23 cmake=3.25.1-1 meson=1.0.1-5 ninja-build=1.11.1-2~deb12u1 \
    && rm -rf /var/lib/apt/lists/*
ENV HOME=/tmp
WORKDIR /out
