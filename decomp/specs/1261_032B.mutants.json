    "replace": "        if (avg >= 0x32u)\n            wr8(m, LIN(fleet_seg, fleet_off), (uint8_t)(rd8(m, LIN(fleet_seg, fleet_off)) | 0x01u));\n        else\n            wr8(m, LIN(fleet_seg, fleet_off), (uint8_t)(rd8(m, LIN(fleet_seg, fleet_off)) & 0xFEu));"
  },
