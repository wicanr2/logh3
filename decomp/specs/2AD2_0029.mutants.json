  {"name": "14CF 的 n 傳 +0x0C", "find": "f_2703_14CF(m, roff, rseg, w0029_rd16s(m, rseg, (uint16_t)(roff + 8u)));", "replace": "f_2703_14CF(m, roff, rseg, w0029_rd16s(m, rseg, (uint16_t)(roff + 0x0Au)));"},
