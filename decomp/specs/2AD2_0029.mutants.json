  {"name": "7 分支 rec[+0x0C] 取 rec[+8] 而不是 rec[+0x0A]", "find": "w0029_rd16s(m, rseg, (uint16_t)(roff + 0x0Au)));", "replace": "w0029_rd16s(m, rseg, (uint16_t)(roff + 8u)));"},
