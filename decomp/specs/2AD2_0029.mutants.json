  {"name": "rec[+2] 取 S[+5]", "find": "(uint16_t)(roff + 2u), rd8(m, LIN(s_seg, (uint16_t)(s_off + 6u))))", "replace": "(uint16_t)(roff + 2u), rd8(m, LIN(s_seg, (uint16_t)(s_off + 5u))))"},
  {"name": "rec[+4] 與 rec[+3] 對調", "find": "    w0029_wr8s(m, rseg, (uint16_t)(roff + 4u), kind);\n    w0029_wr8s(m, rseg, (uint16_t)(roff + 3u), (uint8_t)b_word);", "replace": "    w0029_wr8s(m, rseg, (uint16_t)(roff + 3u), kind);\n    w0029_wr8s(m, rseg, (uint16_t)(roff + 4u), (uint8_t)b_word);"},
  {"name": "rec[+3] 寫 b 的高位元組", "find": "(uint16_t)(roff + 3u), (uint8_t)b_word);", "replace": "(uint16_t)(roff + 3u), (uint8_t)(b_word >> 8));"},
  {"name": "不清 +0x38", "find": "    w0029_wr16s(m, rseg, (uint16_t)(roff + 0x38u), 0);\n", "replace": ""},
  {"name": "不清 +0x3A", "find": "    w0029_wr16s(m, rseg, (uint16_t)(roff + 0x3Au), 0);\n", "replace": ""},
  {"name": "艦種表列的陣營沿用第一次讀的 S[+1](不重讀)", "find": "(uint16_t)(rd8(m, LIN(s_seg, (uint16_t)(s_off + 1u))) * 0xD0u)", "replace": "(uint16_t)(rd8(m, LIN(rseg, roff)) * 0xD0u)"},
  {"name": "艦種表列步幅 0x19", "find": "(uint16_t)(kind * 0x1Au)", "replace": "(uint16_t)(kind * 0x19u)"},
  {"name": "艦種表列陣營步幅 0xCF", "find": "* 0xD0u) + (uint16_t)(kind", "replace": "* 0xCFu) + (uint16_t)(kind"},
  {"name": "艦種表基底 4E3B", "find": "row = (uint16_t)(0x4E3Au +", "replace": "row = (uint16_t)(0x4E3Bu +"},
  {"name": "rec[+0x0A] 取列 +2", "find": "w = w0029_rd16s(m, GIN3_DS, row);", "replace": "w = w0029_rd16s(m, GIN3_DS, (uint16_t)(row + 2u));"},
  {"name": "rec[+0x0A] 寫到 +0x0C", "find": "w0029_wr16s(m, rseg, (uint16_t)(roff + 0x0Au), w);", "replace": "w0029_wr16s(m, rseg, (uint16_t)(roff + 0x0Cu), w);"},
  {"name": "kind 判斷改整個 word", "find": "    if (kind == 7) {", "replace": "    if (kind_word == 7) {"},
