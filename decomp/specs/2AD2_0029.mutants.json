  {"name": "池段位移對調(CFB4 當段)", "find": "uint16_t rseg = rd16(m, DS(0xCFB6));", "replace": "uint16_t rseg = rd16(m, DS(0xCFB4));"},
  {"name": "rec[+0] 取 S[+0]", "find": "w0029_wr8s(m, rseg, roff, rd8(m, LIN(s_seg, (uint16_t)(s_off + 1u))));", "replace": "w0029_wr8s(m, rseg, roff, rd8(m, LIN(s_seg, s_off)));"},
