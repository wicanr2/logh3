  {"name": "第一項扣除改有號除法", "find": "rd8(m, LIN(seg, (uint16_t)(poff + 0x1Fu))) - (uint8_t)((uint16_t)(v * q16) / 100u)", "replace": "rd8(m, LIN(seg, (uint16_t)(poff + 0x1Fu))) - (uint8_t)((int16_t)(v * q16) / 100)"},
