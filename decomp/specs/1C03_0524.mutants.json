    "replace": "f0524_rd16(m, fleet_seg, (uint16_t)(pos + 2u)));\n        f0524_wr16(m, fleet_seg, pos, (uint16_t)(f0524_rd16(m, fleet_seg, pos) - 8u));"
  },
  {
    "name": "回傳結果恆為 1 之外 AH 清 0",
    "find": "return (uint16_t)(((uint16_t)p & 0xFF00u) | 1u);",
    "replace": "return 1u;"
  },
