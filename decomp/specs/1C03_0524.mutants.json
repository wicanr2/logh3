    "replace": ""
  },
  {
    "name": "多步轉向寫 16 位元朝向",
    "find": "        wr8(m, LIN(fleet_seg, head), (uint8_t)(rd8(m, LIN(fleet_seg, head)) + (uint8_t)p));\n",
    "replace": "        f0524_wr16(m, fleet_seg, head, (uint16_t)(f0524_rd16(m, fleet_seg, head) + (uint16_t)p));\n"
  },
  {
    "name": "額度扣 7.0",
    "find": "- 8u));",
    "replace": "- 7u));"
  },
  {
    "name": "額度不扣",
    "find": "        f0524_wr16(m, fleet_seg, (uint16_t)(pos + 2u), (uint16_t)(f0524_rd16(m, fleet_seg, (uint16_t)(pos + 2u)) - 8u));\n",
    "replace": ""
  },
  {
    "name": "額度扣在低字",
