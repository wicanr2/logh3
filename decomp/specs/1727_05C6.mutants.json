[
  {"name": "遮罩表索引多1", "find": "DS(0x3CCCu + bit)", "replace": "DS(0x3CCDu + bit)"},
  {"name": "圖塊表基底多1", "find": "DS(0x3C8Cu + tile)", "replace": "DS(0x3C8Du + tile)"},
  {"name": "圖塊索引只取低6位元", "find": "DS(0x3C8Cu + tile)", "replace": "DS(0x3C8Cu + (tile & 0x3Fu))"},
  {"name": "位元組合用互斥或", "find": "bits = (uint8_t)(bits | (rd8(m, DS(0x3C8Cu + tile)) & mask));", "replace": "bits = (uint8_t)(bits ^ (rd8(m, DS(0x3C8Cu + tile)) & mask));"},
  {"name": "每8欄改每7欄輸出", "find": "if (bit == 7) {", "replace": "if (bit == 6) {"},
  {"name": "累加步長8改7", "find": "acc = (uint8_t)((acc + 8u) % 10u);", "replace": "acc = (uint8_t)((acc + 7u) % 10u);"},
  {"name": "模數10改9", "find": "acc = (uint8_t)((acc + 8u) % 10u);", "replace": "acc = (uint8_t)((acc + 8u) % 9u);"},
  {"name": "重用列的條件改acc等於1", "find": "if (acc == 0 || row == 0x7Fu)", "replace": "if (acc == 1 || row == 0x7Fu)"},
  {"name": "退回列寬少1", "find": "src_off = (uint16_t)(src_off - 0x80u);", "replace": "src_off = (uint16_t)(src_off - 0x7Fu);"},
  {"name": "少輸出一列", "find": "while (row < 0x80u) {", "replace": "while (row < 0x7Fu) {"},
  {"name": "每列少讀一欄", "find": "while (col < 0x80u) {", "replace": "while (col < 0x7Fu) {"},
  {"name": "ROM寫入照寫", "find": "wr8_skip_rom(m, LIN(out_seg, out_off), bits);", "replace": "wr8(m, LIN(out_seg, out_off), bits);"},
  {"name": "ROM邊界多含一格", "find": "wr8_skip_rom(m, LIN(out_seg, out_off), bits);", "replace": "if (LIN(out_seg, out_off) <= 0xF0000u) wr8(m, LIN(out_seg, out_off), bits);"}
,
  {"name": "來源位移回繞改成進位到下一段", "find": "src_off = (uint16_t)(src_off + 1u);", "replace": "src_off = (uint16_t)(src_off + 1u);\n            if (src_off == 0)\n                src_seg = (uint16_t)(src_seg + 0x1000u);"},
  {"name": "輸出位移回繞改成進位到下一段", "find": "out_off = (uint16_t)(out_off + 1u);", "replace": "out_off = (uint16_t)(out_off + 1u);\n                if (out_off == 0)\n                    out_seg = (uint16_t)(out_seg + 0x1000u);"}
]
