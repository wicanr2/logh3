  {"name": "b² 只用 b 的低位元組", "find": "b2 = f_3CC9_0009(0, b, 0, b);", "replace": "b2 = f_3CC9_0009(0, (uint16_t)(b & 0xFFu), 0, (uint16_t)(b & 0xFFu));"},
  {"name": "除法分子分母對調", "find": "gin3_ldivmod((b2 & 0xFFFFu) << 16, (uint32_t)a, &r, &rem);", "replace": "gin3_ldivmod((uint32_t)a, (b2 & 0xFFFFu) << 16, &r, &rem);"},
