  {"name": "005C 的被除數與除數對調", "find": "s = f_39B5_005C(m, (uint16_t)r, (uint16_t)(r >> 16), (uint16_t)den, (uint16_t)(den >> 16));", "replace": "s = f_39B5_005C(m, (uint16_t)den, (uint16_t)(den >> 16), (uint16_t)r, (uint16_t)(r >> 16));"},
  {"name": "e 與 t 的高低字傳反", "find": "p = f_39B5_000C(m, (uint16_t)e, (uint16_t)(e >> 16), (uint16_t)t, (uint16_t)(t >> 16));", "replace": "p = f_39B5_000C(m, (uint16_t)(e >> 16), (uint16_t)e, (uint16_t)t, (uint16_t)(t >> 16));"},
  {"name": "jle 改 jl（相等不算）", "find": "if ((fl & F02DE_ZF) != 0 || ((fl & F02DE_SF) != 0) != ((fl & F02DE_OF) != 0)) /* jle */", "replace": "if (((fl & F02DE_SF) != 0) != ((fl & F02DE_OF) != 0))"},
