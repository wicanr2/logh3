  {"name": "正弦值左移 5", "find": "(int16_t)rd16(m, DS((uint16_t)(0x573Au + 2u * idx))) << 6;", "replace": "(int16_t)rd16(m, DS((uint16_t)(0x573Au + 2u * idx))) << 5;"},
