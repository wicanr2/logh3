  {"name": "+0x1B 沿用第一次讀的 Q[+6](不重讀)", "find": "    w005D_wr8s(m, p_seg, (uint16_t)(p_off + 0x1Bu), rd8(m, LIN(qseg, (uint16_t)(qoff + 6u))));", "replace": "    w005D_wr8s(m, p_seg, (uint16_t)(p_off + 0x1Bu), b);"},
