[
  {"name": "編號取 P[+3]", "find": "w005D_rd16s(m, p_seg, (uint16_t)(p_off + 2u))", "replace": "w005D_rd16s(m, p_seg, (uint16_t)(p_off + 3u))"},
  {"name": "編號取高位元組", "find": "uint32_t q = f_341B_0353(m, w005D_rd16s(m, p_seg, (uint16_t)(p_off + 2u)));", "replace": "uint32_t q = f_341B_0353(m, (uint16_t)(w005D_rd16s(m, p_seg, (uint16_t)(p_off + 2u)) >> 8));"},
  {"name": "段與位移對調", "find": "    uint16_t qseg = (uint16_t)(q >> 16);\n    uint16_t qoff = (uint16_t)q;", "replace": "    uint16_t qoff = (uint16_t)(q >> 16);\n    uint16_t qseg = (uint16_t)q;"},
  {"name": "P[+0] 取 Q[+1]", "find": "w005D_wr8s(m, p_seg, p_off, rd8(m, LIN(qseg, qoff)));", "replace": "w005D_wr8s(m, p_seg, p_off, rd8(m, LIN(qseg, (uint16_t)(qoff + 1u))));"},
