  {"name": "種類改認 1", "find": "rd8(m, LIN(seg, off)) == 2", "replace": "rd8(m, LIN(seg, off)) == 1"},
  {"name": "種類改成位元測試（&2）", "find": "rd8(m, LIN(seg, off)) == 2", "replace": "(rd8(m, LIN(seg, off)) & 2) != 0"},
