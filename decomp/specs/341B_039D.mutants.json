  {"name": "X 範圍的和截成 byte", "find": "&& !((uint16_t)(rd8(m, LIN(seg, (uint16_t)(off + 5u))) + rd8(m, LIN(seg, (uint16_t)(off + 7u)))) <= cell_x)", "replace": "&& !((uint8_t)(rd8(m, LIN(seg, (uint16_t)(off + 5u))) + rd8(m, LIN(seg, (uint16_t)(off + 7u)))) <= cell_x)"},
  {"name": "Y 範圍的和截成 byte", "find": "&& !((uint16_t)(rd8(m, LIN(seg, (uint16_t)(off + 6u))) + rd8(m, LIN(seg, (uint16_t)(off + 8u)))) <= cell_y))", "replace": "&& !((uint8_t)(rd8(m, LIN(seg, (uint16_t)(off + 6u))) + rd8(m, LIN(seg, (uint16_t)(off + 8u)))) <= cell_y))"},
  {"name": "寬高欄位對調（+7 與 +8）", "find": "(uint16_t)(off + 7u)))) <= cell_x)", "replace": "(uint16_t)(off + 8u)))) <= cell_x)"},
  {"name": "下一個的段與位移欄位對調", "find": "nseg = f341B039D_rd16s(m, seg, (uint16_t)(off + 0x18u));\n        noff = f341B039D_rd16s(m, seg, (uint16_t)(off + 0x16u));", "replace": "nseg = f341B039D_rd16s(m, seg, (uint16_t)(off + 0x16u));\n        noff = f341B039D_rd16s(m, seg, (uint16_t)(off + 0x18u));"},
  {"name": "結尾只看位移", "find": "while ((seg | off) != 0) {", "replace": "while (off != 0) {"},
