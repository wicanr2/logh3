  {"name": "左邊界含等於改成不含", "find": "&& !(cell_x < rd8(m, LIN(seg, (uint16_t)(off + 5u))))", "replace": "&& !(cell_x <= rd8(m, LIN(seg, (uint16_t)(off + 5u))))"},
  {"name": "上邊界含等於改成不含", "find": "&& !(cell_y < rd8(m, LIN(seg, (uint16_t)(off + 6u))))", "replace": "&& !(cell_y <= rd8(m, LIN(seg, (uint16_t)(off + 6u))))"},
