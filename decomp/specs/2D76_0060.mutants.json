  {"name": "縮放 × 3 改 × 2", "find": "gin3_ldivmod(gin3_lmul(v, 3u), 4u, &q, &r);", "replace": "gin3_ldivmod(gin3_lmul(v, 2u), 4u, &q, &r);"},
